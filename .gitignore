# Marks THIS working copy as the boilerplate's own dev repo (see file contents).
# Gitignored so clones/copies never inherit it — the detach guards only fire here.
.boilerplate-dev

# Secrets — never commit (see CLAUDE.md Security)
.env*
*.pem
*.key
credentials.json

# OS metadata files
*.DS_Store
Thumbs.db

# Claude Code per-developer local overrides — not part of the template
.claude/settings.local.json

# Raw session transcripts — host-disk backup only, may contain tool output/secrets
_planning/transcripts-backup/

# Subagent run log — records task prompts + result summaries, may contain tool output/secrets
.claude/logs/

# Python bytecode cache (from hook/script runs)
__pycache__/
*.pyc

# Parallel-agent git worktrees — checkouts, not source. Keep them in-repo (under
# /workspace) so the dev container can see them; this ignore stops the parent
# from tracking them. See .claude/README.md §4 "Parallel work: git worktrees".
.worktrees/
# Where Claude Code's own worktree features (`claude --worktree`, the
# EnterWorktree tool, subagent isolation) create theirs. Not auto-ignored.
.claude/worktrees/

# Working status + backlog — private by default. /init asks per-project whether to
# make it public; to commit it, remove this line (or `git add -f _planning/STATUS.md`).
_planning/STATUS.md
