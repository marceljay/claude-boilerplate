{
  "name": "Claude Boilerplate Repo",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Container timezone. A TZ env var on your host wins; else the fallback
      // below. Must be a real zoneinfo name — "Europe/Berlin", not "Etc/Berlin";
      // the Dockerfile fails the build on an invalid one (silent-UTC bug).
      "TZ": "${localEnv:TZ:Europe/Berlin}",
      // Claude Code version baked into the image. "latest" = the newest
      // release at each rebuild, frozen until the next one (its own updater
      // is disabled: it breaks under the repo's .npmrc). Between rebuilds,
      // `cc-update [version]` in a container terminal; pin here (e.g.
      // "2.1.260") only when the team must share one exact version.
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  // Runs on the HOST before every create and start. It refuses unless
  // "Reopen in Container" is enabled on this host (AGENT_ALLOW_VSCODE=1 or
  // ~/.config/zsh/agent-allow-vscode; `agent` from a terminal is the
  // recommended path) and creates the sources for the read-only mounts
  // below. Array form: no shell, paths with spaces are safe.
  "initializeCommand": [
    "sh",
    "${localWorkspaceFolder}/.devcontainer/initialize.sh",
    "${localWorkspaceFolder}"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    // The same read-only overlays scripts/agent.zsh applies: what the host
    // executes (next rebuild, editor open, every git command) cannot be
    // changed from inside. initialize.sh creates .git/commondir and .vscode
    // when missing. Edit these files from a host editor or `agent --setup`.
    // .git is a mount point of its own so it cannot be renamed away and
    // replaced by a writable copy.
    "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.vscode,target=${containerWorkspaceFolder}/.vscode,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=${containerWorkspaceFolder}/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/hooks,target=${containerWorkspaceFolder}/.git/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/commondir,target=${containerWorkspaceFolder}/.git/commondir,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    // Extra flags the shell shortcuts (cc, ccc, ccr, ccw — see
    // claude-harness.zsh) pass to `claude`. Typically the flag that skips
    // permission prompts, which is reasonable in here: the container is the
    // sandbox. Empty = shortcuts prompt like plain `claude`. Per-project by
    // design (this file is ask-first in sync-harness.sh); /init asks once.
    "CLAUDE_SHORTCUT_FLAGS": "",
    // Claude Code's error reports (Sentry) and usage metrics (Statsig) are
    // off, and their hosts are no longer in allowed-domains.txt — both accept
    // posts from anyone with their own project key, i.e. an exfiltration
    // path. Side effect: DISABLE_TELEMETRY also stops feature-flag
    // evaluation, so Remote Control is unavailable in here. agent.zsh sets
    // the same two; keep them in step.
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  // HARDENED VS CODE ATTACH (off by default). The Dev Containers extension
  // opens channels from the container back to the host: SSH agent forwarding
  // (SSH_AUTH_SOCK), a `code` CLI socket (VSCODE_IPC_HOOK_CLI), a
  // remote-containers IPC socket that can run extension commands on the host
  // (REMOTE_CONTAINERS_IPC), a git credential helper backed by the host
  // keychain (GIT_ASKPASS) and $BROWSER (`code --openExternal`: opens ANY
  // URL in the host browser, past the firewall). Blanking the variables
  // only HIDES them from processes in the container — the host still answers
  // on the sockets. It also breaks /dev's browser opening. For real isolation
  // use scripts/agent.zsh (README "Run without VS Code"). To try it anyway:
  // "remoteEnv": {
  //   "BROWSER": "",
  //   "SSH_AUTH_SOCK": "",
  //   "VSCODE_IPC_HOOK_CLI": "",
  //   "REMOTE_CONTAINERS_IPC": "",
  //   "GIT_ASKPASS": ""
  // },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // No `forwardPorts`: dev-server ports are auto-forwarded dynamically, so the
  // editor picks a free *host* port for each container. This is what lets you
  // run several of these containers in parallel without them fighting over the
  // same host port — don't hardcode a host port here or in your dev server
  // (bind it to 0.0.0.0 so the forward works). The host port isn't readable
  // from inside; open URLs via "$BROWSER" (VS Code's openExternal helper),
  // which resolves the forward. See .claude/README.md §7.
  "otherPortsAttributes": { "onAutoForward": "notify" },
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
